generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ExpenseType {
  FIXED
  TEMPTATION
  UNFORESEEN
  LONG_TERM_GOAL
}

model Group {
  id               String        @id @default(uuid())
  qrCodeToken      String        @unique
  name             String
  balance          Float         @default(0.0) // Saldo no mês atual
  savings          Float         @default(0.0) // Saldo acumulado na poupança
  investments      Float         @default(0.0) // Saldo aplicado em investimentos fictícios
  happinessPoints  Int           @default(0)
  currentMonth     Int           @default(0)   // 0 = Mês 0 (RPG), 1-6 = Meses de jogo
  monthStartedAt           DateTime?                   // Timestamp do início do mês atual para sincronização global
  unforeseenTriggeredAt   DateTime?                   // Timestamp de disparo manual de imprevisto pelo admin
  isStarted                Boolean       @default(false)
  isRPGConfirmed          Boolean       @default(false)             // Indica se o grupo concluiu a montagem do personagem no Mês 0
  isGameFinished           Boolean       @default(false)
  achievedGoal             String?                     // Nome da meta final conquistada
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  transactions     Transaction[]
}

model ExpenseOption {
  id               String      @id @default(uuid())
  title            String
  cost             Float
  happinessPoints  Int
  type             ExpenseType
  category         String?     // ex: "Moradia", "Lazer", "Transporte"
  description      String?
  isRPGChoice      Boolean     @default(false)
}

model UnforeseenEvent {
  id                      String   @id @default(uuid())
  title                   String   // ex: "Celular Quebrou"
  description             String
  costToFix               Float
  penaltyIfNotFixedPoints Int      // ex: 30 pontos perdidos se recusar
  restoredPointsIfFixed   Int      // ex: recupera ou ganha pontos ao arrumar
  createdAt               DateTime @default(now())
}

model Transaction {
  id          String   @id @default(uuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  amount      Float
  points      Int
  monthNumber Int
  createdAt   DateTime @default(now())
}

model GameLog {
  id              String   @id @default(uuid())
  groupId         String?
  groupName       String?
  qrCodeToken     String?
  action          String   // ex: "MONTH_TRANSITION", "PAY_FIXED_EXPENSE", "BUY_TEMPTATION", "INVEST_MONEY", "EARLY_WITHDRAW", "DEPOSIT_SAVINGS", "WITHDRAW_SAVINGS", "RESOLVE_UNFORESEEN", "BUY_GOAL", "CONFIRM_RPG", "SCORE_ADJUSTMENT"
  details         String   // Descrição detalhada do evento ou snapshot JSON
  currentMonth    Int
  balance         Float
  savings         Float
  investments     Float
  happinessPoints Int
  createdAt       DateTime @default(now())

  @@index([groupId])
  @@index([qrCodeToken])
  @@index([createdAt])
}

